# Docker Compose environment file for Songhive.
#
# Copy this file to `.env` (next to `docker-compose.yml`) and edit it.
# Compose reads `.env` both for variable interpolation (PUID/PGID,
# SONGHIVE_HTTP_PORT and the ${SONGHIVE_*} references in docker-compose.yml)
# and, via the `env_file` directive, injects every `SONGHIVE_*` variable into
# the songhive/worker/watcher/stream-worker containers — so any setting that
# exists in config.toml can be overridden here as SONGHIVE_<SECTION>__<KEY>.
# Prefer this file over config.toml for secrets.

# UID/GID that the rootless services run as, also used by the `setup` container
# to chown ./volumes. Set these to your host user (`id -u` / `id -g`).
PUID=1000
PGID=1000

# Host port that the bundled Nginx reverse proxy listens on.
# SONGHIVE_HTTP_PORT=80

# Instance identity. These are set through `environment:` in
# docker-compose.yml, so they override the corresponding config.toml values.
# SONGHIVE_FEDERATION__INSTANCE_DOMAIN=music.example.com
# SONGHIVE_FEDERATION__INSTANCE_NAME=My Music
# SONGHIVE_FEDERATION__INSTANCE_DESCRIPTION=A federated music sharing service

# Registration mode: open | invite-only | approval-required | closed
# SONGHIVE_AUTH__REGISTRATION_MODE=open

# Secrets — keep them here rather than in config.toml.
#
# JWT signing secret. If unset, the container entrypoint generates one and
# persists it in volumes/data/secret_key, so you only need this if you want a
# specific value (e.g. to share it with an external tool).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SONGHIVE_AUTH__SECRET_KEY=

# SMTP password for outgoing email ([email] section in config.toml holds the
# host/port/username/from address).
# SONGHIVE_EMAIL__SMTP_PASSWORD=

# VAPID keys for Web Push notifications.
# Generate with: songhive admin generate-vapid-keys
# SONGHIVE_NOTIFICATIONS__VAPID_PUBLIC_KEY=
# SONGHIVE_NOTIFICATIONS__VAPID_PRIVATE_KEY=

# S3 storage credentials (only if [storage] backend = "s3").
# SONGHIVE_STORAGE__S3_ACCESS_KEY=
# SONGHIVE_STORAGE__S3_SECRET_KEY=

# Last.fm / Libre.fm instance API credentials ([scrobbling] section).
# SONGHIVE_SCROBBLING__LASTFM_API_KEY=
# SONGHIVE_SCROBBLING__LASTFM_API_SECRET=
# SONGHIVE_SCROBBLING__LIBREFM_API_KEY=
# SONGHIVE_SCROBBLING__LIBREFM_API_SECRET=
