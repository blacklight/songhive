# Songhive Configuration
# Copy this file to config.toml and adjust values.

[server]
host = "0.0.0.0"
port = 8000
num_workers = 1
debug = false
# Allowed CORS origins. Use ["*"] to allow all origins (not recommended in
# production when allow_credentials is enabled). A comma-separated string or
# JSON list is also accepted from environment variables.
cors_origins = ["*"]

[database]
url = "postgresql+asyncpg://songhive:songhive@localhost:5432/songhive"
pool_size = 5
max_overflow = 10

[redis]
url = "redis://localhost:6379/0"

[celery]
broker_url = "redis://localhost:6379/1"
result_backend = "redis://localhost:6379/2"

[storage]
backend = "local"
local_path = "/var/lib/songhive/media"
# s3_endpoint = "https://s3.amazonaws.com"
# s3_bucket = "songhive-media"
# s3_access_key = ""
# s3_secret_key = ""
# s3_region = "us-east-1"

[federation]
enabled = true
instance_domain = "music.example.com"
instance_name = "Songhive"
instance_description = "A federated music sharing service"

[auth]
registration_enabled = true
secret_key = "change-me-in-production"
token_expiry_hours = 24
