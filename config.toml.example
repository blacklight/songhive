# Songhive Configuration
# Copy this file to config.toml and adjust values.
#
# Any option can also be set via environment variables using the SONGHIVE_
# prefix and __ as a nested separator, e.g. SONGHIVE_DATABASE__URL.

[server]
host = "0.0.0.0"
port = 8000
num_workers = 1
debug = false
# Allowed CORS origins. Use an explicit allow-list in production; wildcard ("*")
# with allow_credentials is insecure and will be ignored. A comma-separated
# string or JSON list is also accepted from environment variables.
cors_origins = []

[database]
url = "postgresql+asyncpg://songhive:songhive@localhost:5432/songhive"
# Or, for SQLite (only recommended for development purposes or small instances):
# url = "sqlite+aiosqlite:///./volumes/db/songhive.db"
pool_size = 5
max_overflow = 10

[redis]
url = "redis://localhost:6379/0"

[celery]
broker_url = "redis://localhost:6379/1"
result_backend = "redis://localhost:6379/2"
# Crontab expression for the orphaned-files cleanup task (default: 03:00 UTC).
# cleanup_orphaned_files_schedule = "0 3 * * *"

[storage]
backend = "local"
local_path = "/var/lib/songhive/media"
# s3_endpoint = "https://s3.amazonaws.com"
# s3_bucket = "songhive-media"
# s3_access_key = ""
# s3_secret_key = ""  # Prefer SONGHIVE_STORAGE__S3_SECRET_KEY for secrets.
# s3_region = "us-east-1"
# cdn_prefix = "https://cdn.example.com"
# Maximum upload size in bytes; defaults to 500 MiB.
# max_upload_size = 524288000
# Maximum number of files in a single bulk upload request; defaults to 50.
# max_bulk_upload_files = 50
# Maximum total size in bytes for a single bulk upload request; defaults to 5 GiB.
# max_bulk_upload_total_size = 5368709120

[federation]
enabled = true
instance_domain = "music.example.com"
instance_name = "Songhive"
instance_description = "A federated music sharing service"
# Optional path to the instance actor's PEM private key. A key is generated
# here automatically when federation is enabled and the file does not exist.
# private_key_path = "/var/lib/songhive/actor.pem"

# ActivityPub instance allow/block lists. An empty allowed_instances list
# means all instances are allowed except those in blocked_instances.
allowed_instances = []
blocked_instances = []

# Examples:
# allowed_instances = ["good.example", "friend.example"]
# blocked_instances = ["evil.example", "spammers.example"]

[musicbrainz]
# Enable MusicBrainz metadata + Cover Art Archive enrichment for uploaded tracks.
enabled = true
# User-Agent string sent to MusicBrainz. Include a contact URL or email per
# MusicBrainz policy when running a public instance.
# user_agent = "Songhive/0.0 ( https://example.com )"
# Maximum MusicBrainz API requests per second (per worker).
# rate_limit_per_second = 1.0
# Fetch cover art from the Cover Art Archive when a matching release is found.
# fetch_cover_art = true
# Fetch artist images from MusicBrainz URL relations (e.g. Wikimedia Commons).
# fetch_artist_images = true

[imports]
# Allowed filesystem roots for directory/bulk imports. Sub-paths outside these
# roots are rejected. A comma-separated string or JSON list is also accepted
# from environment variables.
# scan_roots = ["/path/to/music"]
# Maximum number of files handled synchronously in a bulk upload; larger
# batches are queued as Celery tasks.
# bulk_import_sync_threshold = 20

[auth]
# Supported: "open", "invite-only", "approval-required", "closed"
registration_mode = "open"
require_email_verification = false
# Number of trusted reverse-proxy hops for X-Forwarded-For parsing.
# 0 disables trust in the header.
# trusted_proxy_hops = 0
# JWT signing secret. Generate a strong random key of at least 32 bytes and
# replace this placeholder, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
secret_key = "####CHANGEME####"
access_token_expiry_minutes = 15
refresh_token_expiry_days = 30
password_reset_token_expiry_minutes = 30
rate_limit_enabled = true
rate_limit_requests = 10
rate_limit_window_seconds = 60

[streaming]
# Path to the ffmpeg binary. When omitted, Songhive searches PATH.
# ffmpeg_path = "/usr/bin/ffmpeg"
max_bitrate = "320k"
# Per-role bitrate ceilings. Uncomment to override defaults.
# max_bitrate_by_role = { user = "192k", moderator = "256k", admin = "320k" }
default_bitrate = "192k"
chunk_size = 65536
transcode_cache_enabled = true

[email]
# Uncomment and configure these to enable outbound email (verification,
# password reset, etc.).
# smtp_host = "smtp.example.com"
# smtp_port = 587
# smtp_username = ""
# smtp_password = ""  # Prefer SONGHIVE_EMAIL__SMTP_PASSWORD for secrets.
# smtp_tls = true
# from_address = "songhive@example.com"

[external_libraries]
# External (cloud/storage-provider) libraries. Keep this disabled unless you
# explicitly want users to configure third-party music sources.

# Safe default: do not allow non-admin users to create external libraries.
allow_user_created_libraries = false

# When allow_user_created_libraries is true, restrict non-admin users to these
# provider types. Empty means all user_configurable providers are allowed.
# Examples: ["local", "s3", "webdav"]
allowed_user_providers = []

# Provider types non-admin users may never configure, regardless of allow list.
denied_user_providers = []

# Whether admins may include admin-managed external libraries in the default
# /libraries view.
allow_admin_library_index_inclusion = true

# Global kill-switch for destructive provider-side deletion.
allow_destructive_delete = false

# Minimum number of seconds between consecutive sync runs for a library.
minimum_sync_interval_seconds = 300

# Maximum number of external library syncs that may run concurrently.
max_concurrent_syncs = 4

# Directory for external stream temp/cache files. Uses system temp when None.
# stream_temp_dir = "/var/lib/songhive/external-temp"

# Max bytes Songhive will proxy through memory before spilling to disk.
stream_max_proxy_bytes = 268435456

# Timeout in seconds for proxied external stream responses.
stream_proxy_timeout_seconds = 60

# Filesystem roots a 'local' external library may point at.  Empty means no
# local libraries are allowed. Restrict to intended mount points, and remember
# that this is a local-file-read vector. A comma-separated string or JSON list
# is also accepted from environment variables.
# Examples: ["/mnt/music", "/media"]
local_roots = []
