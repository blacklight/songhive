# Songhive Configuration
# Copy this file to config.toml and adjust values.

[server]
host = "0.0.0.0"
port = 8000
num_workers = 1
debug = false
# Allowed CORS origins. Use an explicit allow-list in production; wildcard ("*")
# with allow_credentials is insecure and will be ignored. A comma-separated
# string or JSON list is also accepted from environment variables.
cors_origins = []

[database]
url = "postgresql+asyncpg://songhive:songhive@localhost:5432/songhive"
pool_size = 5
max_overflow = 10

[redis]
url = "redis://localhost:6379/0"

[celery]
broker_url = "redis://localhost:6379/1"
result_backend = "redis://localhost:6379/2"

[storage]
backend = "local"
local_path = "/var/lib/songhive/media"
# s3_endpoint = "https://s3.amazonaws.com"
# s3_bucket = "songhive-media"
# s3_access_key = ""
# s3_secret_key = ""
# s3_region = "us-east-1"
# cdn_prefix = "https://cdn.example.com"

[federation]
enabled = true
instance_domain = "music.example.com"
instance_name = "Songhive"
instance_description = "A federated music sharing service"

[auth]
registration_mode = "open"
require_email_verification = false
# JWT signing secret. Generate a strong random key and never commit it:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# secret_key = ""
access_token_expiry_minutes = 15
refresh_token_expiry_days = 30
password_reset_token_expiry_minutes = 30
rate_limit_enabled = true
rate_limit_requests = 10
rate_limit_window_seconds = 60

[email]
# Uncomment and configure these to enable outbound email (verification,
# password reset, etc.).
# smtp_host = "smtp.example.com"
# smtp_port = 587
# smtp_username = ""
# smtp_password = ""  # Prefer SONGHIVE_EMAIL__SMTP_PASSWORD for secrets.
# smtp_tls = true
# from_address = "songhive@example.com"
