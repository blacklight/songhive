# Songhive Configuration
# Copy this file to config.toml and adjust values.
#
# Any option can also be set via environment variables using the SONGHIVE_
# prefix and __ as a nested separator, e.g. SONGHIVE_DATABASE__URL.

[server]
host = "0.0.0.0"
port = 8000
num_workers = 1
debug = false
# Allowed CORS origins. Use an explicit allow-list in production; wildcard ("*")
# with allow_credentials is insecure and will be ignored. A comma-separated
# string or JSON list is also accepted from environment variables.
cors_origins = []

[database]
url = "postgresql+asyncpg://songhive:songhive@localhost:5432/songhive"
# Or, for SQLite (only recommended for development purposes or small instances):
# url = "sqlite+aiosqlite:///./volumes/db/songhive.db"
# The total connection budget is processes x event-loops x (pool_size +
# max_overflow). The synchronous federation-storage engine has fixed small
# bounds of its own (pool_size=2, max_overflow=3 — pubby calls are short),
# and short-lived Celery/CLI task loops cap their async pool at 1+2. Keep
# max_connections in Postgres comfortably above the sum across all
# app/Celery/worker processes.
pool_size = 5
max_overflow = 10
# Seconds a request may wait for a pooled connection before failing fast
# with 503. Bounds queueing during traffic spikes instead of exhausting the
# database's connection limit. Kept below typical remote fetch timeouts —
# work nobody receives is shed early as a retryable 503.
# pool_timeout = 5
# Seconds after which a pooled connection is recycled.
# pool_recycle = 1800
# Test pooled connections for liveness on checkout.
# pool_pre_ping = true

[redis]
url = "redis://localhost:6379/0"

[celery]
broker_url = "redis://localhost:6379/1"
result_backend = "redis://localhost:6379/2"
# Crontab expression for the orphaned-files cleanup task (default: 03:00 UTC).
# cleanup_orphaned_files_schedule = "0 3 * * *"

[storage]
backend = "local"
local_path = "/var/lib/songhive/media"
# s3_endpoint = "https://s3.amazonaws.com"
# s3_bucket = "songhive-media"
# s3_access_key = ""
# s3_secret_key = ""  # Prefer SONGHIVE_STORAGE__S3_SECRET_KEY for secrets.
# s3_region = "us-east-1"
# cdn_prefix = "https://cdn.example.com"
# Maximum upload size in bytes; defaults to 500 MiB.
# max_upload_size = 524288000
# Maximum number of files in a single bulk upload request; defaults to 50.
# max_bulk_upload_files = 50
# Maximum total size in bytes for a single bulk upload request; defaults to 5 GiB.
# max_bulk_upload_total_size = 5368709120
# Default per-user upload quota in bytes for media uploads by non-admin
# users; unset means unlimited. Admins can override it per user (higher,
# lower, or no quota at all).
# upload_quota = 1073741824

[federation]
enabled = true
instance_domain = "music.example.com"
instance_name = "Songhive"
instance_description = "A federated music sharing service"
# Optional contact person for this instance. Shown on the /about page and
# advertised in the nodeinfo metadata. The email address is displayed
# obfuscated in the web UI.
# contact_name = "Instance Admin"
# contact_email = "admin@example.com"
# contact_url = "https://example.com/@admin"
# Optional path to the instance actor's PEM private key. A key is generated
# here automatically when federation is enabled and the file does not exist.
# private_key_path = "/var/lib/songhive/actor.pem"

# ActivityPub instance allow/block lists. An empty allowed_instances list
# means all instances are allowed except those in blocked_instances.
allowed_instances = []
blocked_instances = []

# Timeout (seconds) for each outbound remote fetch — WebFinger resolution,
# actor and object dereferencing. Applied per request hop.
# fetch_timeout_seconds = 20

# Remote activities (posts received from remote actors) older than this many
# days are pruned by the prune-remote-activities task when no local user has
# interacted with them. Pruned objects can always be retrieved again through
# remote URL search. Only activities from followed actors are stored in the
# first place, so this bounds the cache of followed feeds.
# remote_activity_retention_days = 30

# Optional 5-field cron expression scheduling automatic remote-activity
# pruning (e.g. "0 4 * * *" for a daily 04:00 run). When unset, pruning only
# runs manually via `songhive admin prune-remote-activities`, the admin API,
# or the admin Tasks page.
# remote_activity_prune_schedule = "0 4 * * *"

# Seconds a served ActivityPub document (actor, WebFinger, object,
# collection or nodeinfo dereference) may be reused from the in-process
# cache. A boosted post makes hundreds of remote instances dereference the
# same URLs at once; the cache collapses that stampede into a single render
# and emits a matching Cache-Control header (the entry's remaining
# freshness). 0 disables caching; misses (404s) are cached for at most 15
# seconds regardless.
# document_cache_ttl_seconds = 60

# Cap on how long the reverse proxy's edge cache (nginx proxy_cache) may
# serve a dereference document. The app emits X-Accel-Expires bounded by
# both the document's remaining in-process freshness and this cap, so the
# edge TTL can never outlive the app's freshness policy — app-side
# invalidation cannot reach the edge cache, which is why the cap is kept
# short. Must match docker/nginx.conf's proxy_cache_valid fallback.
# 0 disables edge caching entirely.
# edge_cache_ttl_seconds = 15

# Examples:
# allowed_instances = ["good.example", "friend.example"]
# blocked_instances = ["evil.example", "spammers.example"]

[webmentions]
# Enable Webmention support: incoming mentions are accepted at /webmentions and
# outgoing mentions are sent for URLs found in public local activities. Requires
# federation.instance_domain to be set so URLs can be built and validated.
enabled = true
# Timeout in seconds for outgoing Webmention HTTP requests
# request_timeout = 15
# Maximum response body size (in bytes) fetched for endpoint discovery and
# source parsing
# discovery_max_bytes = 1048576

[feeds]
# Enable RSS/Atom feeds under /feeds and the <link rel="alternate"> feed
# discovery tags injected into object pages.
enabled = true
# Maximum number of items returned in a feed (1-500).
# max_items = 20

[musicbrainz]
# Enable MusicBrainz metadata + Cover Art Archive enrichment for uploaded tracks.
enabled = true
# User-Agent string sent to MusicBrainz. Include a contact URL or email per
# MusicBrainz policy when running a public instance.
# user_agent = "Songhive/0.0 ( https://example.com )"
# Maximum MusicBrainz API requests per second (per worker).
# rate_limit_per_second = 1.0
# Fetch cover art from the Cover Art Archive when a matching release is found.
# fetch_cover_art = true
# Fetch artist images from MusicBrainz URL relations (e.g. Wikimedia Commons).
# fetch_artist_images = true

[imports]
# Allowed filesystem roots for directory/bulk imports. Sub-paths outside these
# roots are rejected. A comma-separated string or JSON list is also accepted
# from environment variables.
# scan_roots = ["/path/to/music"]
# Maximum number of files handled synchronously in a bulk upload; larger
# batches are queued as Celery tasks.
# bulk_import_sync_threshold = 20

[downloads]
# Enable bulk download archives (ZIP generation for tracks, albums, artists,
# playlists) and the /api/v1/downloads endpoints.
# enabled = true
# Maximum number of items a single archive request may resolve to.
# max_items = 500
# Maximum number of archive builds running concurrently across the instance.
# max_concurrent_archives = 2
# Maximum number of pending/processing archives a single user may hold.
# max_active_per_user = 2
# Hours a completed archive is kept before periodic cleanup removes it.
# retention_hours = 24
# Hours after which an archive stuck in pending/processing is marked failed.
# stale_run_hours = 6
# Attempts per item for remote/external fetches (exponential backoff).
# fetch_attempts = 3
# Base delay in seconds between item fetch attempts.
# fetch_backoff_seconds = 2.0
# Timeout in seconds for each remote audio fetch hop.
# fetch_timeout_seconds = 30.0
# Maximum bytes fetched for a single remote/external item.
# max_item_bytes = 2147483648

[auth]
# Supported: "open", "invite-only", "approval-required", "paid", "closed"
# "paid" requires [payments] to be enabled and configured; new accounts stay
# inactive until their membership subscription is confirmed by the provider.
registration_mode = "open"
require_email_verification = false
# Number of trusted reverse-proxy hops. A value greater than 0 enables
# X-Forwarded-For client-IP parsing and X-Forwarded-Proto scheme detection.
# 0 disables trust in both headers.
# trusted_proxy_hops = 0
# JWT signing secret. Generate a strong random key of at least 32 bytes and
# replace this placeholder, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
secret_key = "####CHANGEME####"
access_token_expiry_minutes = 15
refresh_token_expiry_days = 30
password_reset_token_expiry_minutes = 30
rate_limit_enabled = true
rate_limit_requests = 10
rate_limit_window_seconds = 60
# Separate, looser budget for file/track downloads (per user or IP, per
# file URL). 0 disables download limiting; image/* files (avatars, cover
# art, image attachments) are never rate limited.
rate_limit_media_requests = 60

[payments]
# Enable payments: artists can sell tracks/albums through their own Stripe
# Connect accounts, and registration_mode = "paid" can gate the instance
# behind a paid membership. Requires the `stripe` package.
enabled = false

# Stripe secret API key (sk_live_.../sk_test_...). Required when enabled.
# Prefer SONGHIVE_PAYMENTS__STRIPE_SECRET_KEY for secrets.
#
# Artist payouts use Stripe Connect: before sellers can onboard, your Stripe
# account must have Connect enabled — open the Dashboard, go to Connect ->
# Get started (https://dashboard.stripe.com/connect/overview) and complete
# the platform profile (platform name, industry, support details). Seller
# accounts are created through the Accounts v2 API with merchant
# card_payments + recipient stripe_transfers capabilities — the seller's
# country of operation is collected in the UI at onboarding time.
# stripe_secret_key = ""

# Stripe-hosted dashboard for seller accounts. "full" gives sellers the
# standard Stripe dashboard with Stripe-collected fees and Stripe-carried
# negative-balance liability — the only combination self-serve platforms may
# use. "express" gives sellers the lighter co-branded Express dashboard but
# requires Stripe approval: platform-managed risk for stripe_losses_collector
# = "application", or enrollment in the Express + Stripe-managed-liability
# preview for "stripe". Without approval, Stripe rejects account creation
# with account_controller_unsupported_configuration or
# account_creation_losses_collector_unavailable.
# stripe_dashboard = "full"

# Connect losses_collector for new seller accounts, only when
# stripe_dashboard = "express". "application" makes your platform liable for
# connected-account negative balances and requires Stripe approval for
# managed risk; "stripe" requires the gated Express preview above. Ignored
# when stripe_dashboard = "full" (always "stripe").
# stripe_losses_collector = "stripe"

# Webhook signing secrets (whsec_...). These are NOT the same as payment
# links or API keys — each secret is generated when you register a webhook
# endpoint in the Stripe Dashboard. Steps (turn on "Test mode" first when
# testing; dashboard.stripe.com/test/webhooks):
#
#   1. Open Workbench -> Webhooks tab (older dashboards: Developers ->
#      Webhooks) and click "Create an event destination" ("Add endpoint").
#   2. Platform endpoint — choose "Events on your account", select events
#        checkout.session.completed, invoice.paid, invoice.payment_failed,
#        customer.subscription.updated, customer.subscription.deleted
#      then "Webhook endpoint", URL:
#        https://<your-domain>/api/v1/payments/webhooks/stripe
#   3. Connect endpoint — repeat, but choose "Events on connected
#      accounts" (requires Stripe Connect; older dashboards: check "Listen
#      to events on Connected accounts"), select events
#        checkout.session.completed, charge.refunded,
#        charge.dispute.created, charge.dispute.closed, account.updated
#      URL: https://<your-domain>/api/v1/payments/webhooks/stripe-connect
#      IMPORTANT: this choice is made at destination creation and cannot be
#      changed later. A destination listening on "your account" never
#      receives purchase events — artist sales are direct charges on the
#      seller's connected account, so checkout.session.completed for a
#      purchase is emitted there, not on the platform account. If the flag
#      is wrong, delete the destination and recreate it.
#   4. Open each destination's settings page — under "Signing secret",
#      click "Reveal secret" and copy the whsec_... value into the
#      matching option below (platform secret for the platform endpoint,
#      connect secret for the connected-accounts endpoint).
#
# Payload type: all events above are v1 "snapshot" events (the full object
# is embedded in data.object), which is what Songhive verifies. Do not
# enable v2/thin API categories — e.g. "Accounts v2" sends v2 thin events
# carrying only an event ID. The v1 account.updated event lives under the
# plain "Accounts" category on the Connect destination. Extra v1 event
# types are harmless — unhandled ones are recorded as "ignored".
#
# For local development, `stripe listen` prints a shared whsec_... secret
# usable for both:
#   stripe listen \
#     --forward-to localhost:8000/api/v1/payments/webhooks/stripe \
#     --forward-connect-to localhost:8000/api/v1/payments/webhooks/stripe-connect
#
# stripe_platform_webhook_secret = ""
# stripe_connect_webhook_secret = ""

# Canonical https:// public base URL used to build checkout, redemption, and
# email links. Falls back to federation.instance_domain when unset; payments
# fail closed when neither resolves to an absolute URL.
# public_base_url = "https://music.example.com"

# ISO-4217 currencies accepted for artist sales (lowercase).
# supported_currencies = ["usd"]

# Sale price bounds in minor units (cents) of the sale currency.
# min_price_minor = 50
# max_price_minor = 1000000

# Instance membership pricing. Also editable at runtime from the admin
# settings page (membership_price_minor, membership_currency,
# membership_interval).
# default_membership_amount_minor = 500   # $5.00
# membership_currency = "USD"
# membership_interval = "month"           # "week", "month", or "year"

# Stripe product/price provisioning for memberships. The lookup key is used
# to find or create the recurring Price; change it only if you rotate prices.
# membership_product_name = "Songhive membership"
# membership_price_lookup_key = "songhive-membership-v1"

# Audio samples offered to unpaid listeners on "sample"-policy sales.
# default_sample_seconds = 30
# sample_max_seconds = 120

# Guest purchases: opaque redemption links emailed to the buyer.
# redeem_capability_ttl_days = 30         # link validity
# guest_redemption_limit = 10             # max redemptions per link
# artifact_ttl_hours = 24                 # cached paid-archive (ZIP) lifetime

# Paid memberships: hours of access preserved after the provider-confirmed
# paid_through timestamp when a renewal payment fails, before the account
# deactivates.
# membership_grace_hours = 72

# Lifetime (seconds) of the scoped billing capability issued to unpaid users
# at login/registration so they can reach membership checkout while inactive.
# billing_capability_ttl_seconds = 1800

# Internal tuning: TTL (hours) of pending checkout orders before they expire,
# and TTL (seconds) of the Redis locks around fulfillment/sample rendering.
# checkout_session_ttl_hours = 23
# fulfillment_lock_ttl_seconds = 300

[streams]
# Path to the ffmpeg binary used by the stream worker. If unset, it falls back
# to the system PATH and to streaming.ffmpeg_path.
# icecast_ffmpeg_path = "/usr/bin/ffmpeg"

# Seconds between stream worker session discovery scans. Lower values start
# outputs faster; higher values reduce database load.
# worker_poll_interval_seconds = 1.0

# TTL (in seconds) for the Redis lock that ensures only one worker drives an
# output at a time. Must be longer than the longest expected command round-trip.
# worker_lock_ttl_seconds = 60

# Seconds a background stream may stay idle before stopping. A zero value
# disables idle shutdown.
# background_idle_timeout_seconds = 900

# Hosts that user-created remote outputs may target (Icecast mounts, Snapcast
# TCP sources). Empty means all hosts are allowed (not recommended for public
# instances).
# allowed_output_hosts = []

# Whether regular users may create server-side outputs. Admins can always
# create outputs if a provider is available.
# allow_user_created_outputs = false

# Provider types non-admin users are allowed to create. Empty means all
# user-configurable providers are allowed.
# allowed_user_providers = []

# Provider types non-admin users may never configure, regardless of
# allowed_user_providers.
# denied_user_providers = []

# Native HTTP outputs (provider_type "http") serve mountpoints at
# /streams/<mount> on the main server port, fanned out to listeners through a
# capped Redis stream. These knobs tune that transport.
#
# Approximate maximum entries buffered per mount (~16 KiB per chunk).
# http_stream_max_entries = 512

# Entries bursted to a new listener on connect so it can start decoding
# immediately (8 ≈ 128 KiB).
# http_stream_burst_entries = 8

# Maximum age (seconds) of buffered audio delivered to a listener. Chunks
# older than this are skipped, so a client that falls behind jumps forward
# instead of accumulating latency. 0 disables lag dropping.
# http_stream_max_lag_seconds = 5.0

# Maximum concurrent listeners per mount; 0 disables the cap.
# http_stream_max_listeners = 64

# ICY metadata interval in bytes. Listeners that send "Icy-MetaData: 1"
# receive a StreamTitle block every metaint bytes of audio so track changes
# update their now-playing display.
# http_stream_metaint_bytes = 16384

# Live broadcasting lets the owner of a native HTTP mount send device audio
# (browser MediaRecorder over /ws/live/<output_id>) through the mount to its
# listeners. Requires the stream worker to be running.
# live_enabled = true

# Average ingest bitrate cap enforced by the ingest socket (abuse guard).
# live_max_bitrate_kbps = 320

# Maximum length of one broadcast in seconds; 0 is unlimited.
# live_max_duration_seconds = 0

# Approximate MAXLEN of the Redis stream buffering live audio between the
# ingest socket and the worker — a hiccup buffer only.
# live_ingest_max_entries = 256

# Seconds the ingest socket waits for the worker to report the broadcast on
# air before failing.
# live_start_timeout_seconds = 15.0

[streaming]
# Path to the ffmpeg binary. When omitted, Songhive searches PATH.
# ffmpeg_path = "/usr/bin/ffmpeg"
max_bitrate = "320k"
# Per-role bitrate ceilings. Uncomment to override defaults.
# max_bitrate_by_role = { user = "192k", moderator = "256k", admin = "320k" }
default_bitrate = "192k"
chunk_size = 65536
transcode_cache_enabled = true

[email]
# Uncomment and configure these to enable outbound email (verification,
# password reset, etc.).
# smtp_host = "smtp.example.com"
# smtp_port = 587
# smtp_username = ""
# smtp_password = ""  # Prefer SONGHIVE_EMAIL__SMTP_PASSWORD for secrets.
# smtp_tls = true
# from_address = "songhive@example.com"

[notifications]
# Days to keep seen notifications before the nightly purge.
# retention_days = 90
# Hour of day (UTC) for the nightly purge and digest tasks.
# purge_hour = 3
# digest_hour = 8

# Web Push (OS-native) notifications. Requires VAPID keys; generate them with:
#   songhive admin generate-vapid-keys
# The vapid_subscriber must be a mailto: or https: URL used for the VAPID claim.
# vapid_public_key = ""
# vapid_private_key = ""  # Prefer SONGHIVE_NOTIFICATIONS__VAPID_PRIVATE_KEY.
# vapid_subscriber = "mailto:admin@example.com"
# push_enabled = true
# push_timeout = 15.0

[external_libraries]
# External (cloud/storage-provider) libraries. Keep this disabled unless you
# explicitly want users to configure third-party music sources.

# Safe default: do not allow non-admin users to create external libraries.
allow_user_created_libraries = false

# When allow_user_created_libraries is true, restrict non-admin users to these
# provider types. Empty means all user_configurable providers are allowed.
# Examples: ["local", "s3", "sftp", "webdav", "gdrive", "jellyfin", "tidal"]
allowed_user_providers = []

# Provider types non-admin users may never configure, regardless of allow list.
denied_user_providers = []

# Whether admins may include admin-managed external libraries in the default
# /libraries view.
allow_admin_library_index_inclusion = true

# Global kill-switch for destructive provider-side deletion.
allow_destructive_delete = false

# Minimum number of seconds between consecutive sync runs for a library.
minimum_sync_interval_seconds = 300

# Maximum number of external library syncs that may run concurrently.
max_concurrent_syncs = 4

# Directory for external stream temp/cache files. Uses system temp when None.
# stream_temp_dir = "/var/lib/songhive/external-temp"

# Max bytes Songhive will proxy through memory before spilling to disk.
stream_max_proxy_bytes = 268435456

# Timeout in seconds for proxied external stream responses.
stream_proxy_timeout_seconds = 60

# Filesystem roots a 'local' external library may point at.  Empty means no
# local libraries are allowed. Restrict to intended mount points, and remember
# that this is a local-file-read vector. A comma-separated string or JSON list
# is also accepted from environment variables.
# Examples: ["/mnt/music", "/media"]
local_roots = []

[external_libraries.tidal]
# Instance-level defaults for the TIDAL provider. Users connect their
# account via the "Connect TIDAL" device-code flow; the optional client
# overrides below only matter if the built-in tidalapi credentials stop
# working for your instance.
# client_id = ""
# client_secret = ""
# client_id_pkce = ""
# client_secret_pkce = ""

# Who may stream TIDAL tracks owned by another user's library:
#   "owner"            - only the library owner (and admins); recommended.
#   "listener_account" - non-owners stream through their own TIDAL library.
#   "anyone"           - any ACL-authorized local user uses the owner's session.
stream_policy = "owner"

# Lazy playlist/album contents caching.
playlist_ttl_seconds = 21600
minimum_playlist_ttl_seconds = 300
album_contents_ttl_seconds = 2592000
catalog_ttl_seconds = 2592000
lazy_contents_wait_seconds = 10

# Per-account client-side request throttle for outbound TIDAL API calls.
max_requests_per_second = 5

# HTTP timeout applied to every outbound TIDAL request, including token
# refresh. Bounds the failure mode where a stalled connection would park
# a sync/stream task forever (requests has no built-in timeout).
request_timeout_seconds = 30

# TIDAL downloads (FLAC/AAC). Off by default: content is for the
# subscriber's personal use under TIDAL's terms.
allow_downloads = false
download_format = "flac"

# Remote-audio remux cache (segmented/Hi-Res streams, reusable by future
# providers). Retention by age and a total size cap both apply. Per-library
# "mpd_mode" chooses "segments" (default, zero storage, no seeking) or
# "remux" (ffmpeg stream-copy into this cache, seekable).
# remote_cache_dir = "/var/lib/songhive/remote-audio"
remote_cache_max_bytes = 524288000
remote_cache_retention_seconds = 604800

[external_libraries.youtube]
# Instance-level defaults for the YouTube provider. Users connect their
# Google account via the "Connect YouTube" device-code flow or by pasting
# the request headers of a browser session (whose cookies are saved and
# automatically handed to yt-dlp for gated/age-restricted content).
#
# The device flow needs a Google OAuth client of the "TVs and limited input
# devices" type with the YouTube Data API v3 enabled; create one at
# https://console.cloud.google.com/apis/credentials. Both empty disables the
# Connect button — pasted browser session headers still work.
# client_id = ""
# client_secret = ""

# Who may stream YouTube items owned by another user's library:
#   "owner"            - only the library owner (and admins); recommended.
#   "listener_account" - non-owners stream through their own YouTube library.
#   "anyone"           - any ACL-authorized local user uses the owner's session.
stream_policy = "owner"

# Playback of the full video+audio rendition (audio-only is the default).
video_playback = true
# yt-dlp format selector for video+audio playback.
video_format = "best[height<=720][acodec!=none][vcodec!=none]/best"

# yt-dlp downloads (audio-only or video+audio). Off by default: YouTube
# content is for personal use under YouTube's terms of service.
allow_downloads = false
download_format = "audio"

# Lazy playlist contents + catalog caching.
playlist_ttl_seconds = 21600
minimum_playlist_ttl_seconds = 300
catalog_ttl_seconds = 2592000

# Per-account client-side throttle + HTTP timeouts for YouTube API calls.
max_requests_per_second = 5
request_timeout_seconds = 30

# How long resolved yt-dlp stream URLs stay cached in Redis, and the
# timeout for yt-dlp format resolution/downloads.
stream_url_ttl_seconds = 300
download_timeout_seconds = 600

[subsonic]
# Subsonic/OpenSubsonic-compatible API adapter mounted at /rest. When
# enabled, Subsonic clients (DSub, Tempo, Symfonium, ...) can browse and
# stream the instance's library after logging in with a Songhive username
# and password or API token.
enabled = true

[scrobbling]
# Scrobbling to Audioscrobbler-compatible services (Last.fm, Libre.fm).
# When enabled, users can connect an account from /settings?tab=scrobbling;
# plays then submit "now playing" updates and full scrobbles once the
# user's thresholds are met (default: 30 seconds or 25% of the track).
# A service is selectable only when its API key pair is configured below —
# the instance acts as the API application and stores per-user session keys.
enabled = true
# request_timeout_seconds = 15
# Register an API account at https://www.last.fm/api/account/create
# lastfm_api_key = ""
# lastfm_api_secret = ""
# librefm_api_key = ""
# librefm_api_secret = ""
