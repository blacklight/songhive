[Unit]
Description=Songhive Celery worker and scheduler
PartOf=songhive.service
After=network.target

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@DATA_DIR@@
Environment="SONGHIVE_CONFIG=@@CONFIG_DIR@@/config.toml"
Environment="PATH=@@VENV_DIR@@/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=@@VENV_DIR@@/bin/celery -A songhive.tasks worker -B -l info -s @@SCHEDULE_FILE@@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=@@WANTED_BY@@
